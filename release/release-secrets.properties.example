# ------------------------------------------------------------------
# Example template for release/release-secrets.properties
#
# Copy this file to release/release-secrets.properties and fill in the
# real values. The real file is gitignored and must NOT be committed.
#
# The keystore path is resolved relative to android/app/ (the directory
# of android/app/build.gradle).
# ------------------------------------------------------------------

MYSCOREKEEPER_STORE_FILE=release-keystore.keystore
MYSCOREKEEPER_STORE_PASSWORD=android
MYSCOREKEEPER_KEY_ALIAS=release
MYSCOREKEEPER_KEY_PASSWORD=android
